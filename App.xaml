<Application x:Class="InerConfig.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F7F9FC"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Text" Color="#27374D"/><SolidColorBrush x:Key="Muted" Color="#77869B"/>
  <SolidColorBrush x:Key="Line" Color="#DEE5EF"/><SolidColorBrush x:Key="Property" Color="#F1F5FA"/>
  <SolidColorBrush x:Key="Selected" Color="#DCEBFD"/><SolidColorBrush x:Key="Blue" Color="#087AF5"/>
  <DataTemplate x:Key="NodeArrow">
   <Grid Width="10" Height="10">
    <Path x:Name="Chevron" Data="M 1,3 L 5,7 L 9,3" Stroke="{DynamicResource Text}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"/>
    <Ellipse x:Name="LeafDot" Width="2" Height="2" Fill="{DynamicResource Muted}" Visibility="Collapsed"/>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding HasVisibleChildren}" Value="False"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter></DataTrigger>
    <DataTrigger Binding="{Binding Group}" Value="False"><Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/><Setter TargetName="LeafDot" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding Kind}" Value="Add"><Setter TargetName="LeafDot" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Comment"><Setter TargetName="LeafDot" Property="Visibility" Value="Collapsed"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <ControlTemplate x:Key="StageResizeGrip" TargetType="Thumb"><Border Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Line}"/></Border></ControlTemplate>
  <ControlTemplate x:Key="CompactTypePicker" TargetType="ComboBox">
   <Grid>
    <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4"><Path Data="M0,0 L3,3 L6,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="6,0,18,0" VerticalAlignment="Center"/>
    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ItemsPresenter/></Border></Popup>
   </Grid>
  </ControlTemplate>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="pack://application:,,,/Assets/Fonts/#Pretendard"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Canvas}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="GridText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Margin" Value="12,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Property}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Padding" Value="10,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="3"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="8"><TextBlock Text="⌄" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="10,5,28,5" VerticalAlignment="Center"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ContextMenu">
   <Setter Property="FontFamily" Value="pack://application:,,,/Assets/Fonts/#Pretendard"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="HasDropShadow" Value="False"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="MinWidth" Value="180"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Border Margin="8" Padding="5" CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
     <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
     <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600">
      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
     </ScrollViewer>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid>
     <Border x:Name="MenuBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
       <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="15" Height="15"/>
       <Path x:Name="Check" Visibility="Collapsed" Data="M 1,6 L 5,10 L 12,2" Stroke="{DynamicResource Blue}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="1,0,12,0"/>
       <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
       <Path x:Name="SubArrow" Grid.Column="3" Visibility="Collapsed" Data="M 1,1 L 5,5 L 1,9" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="5" Margin="3">
       <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBody" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger Property="HasItems" Value="True"><Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuBody" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{DynamicResource Line}" Height="1" Margin="10,5"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollViewer">
   <Style.Resources><SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/></Style.Resources>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent">
     <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
       <Grid Background="Transparent"><Border x:Name="Grip" Width="5" HorizontalAlignment="Center" Background="{DynamicResource Muted}" Opacity="0.4" CornerRadius="2.5" Margin="0,2"/></Grid>
       <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
         <Setter TargetName="Grip" Property="Width" Value="Auto"/><Setter TargetName="Grip" Property="Height" Value="5"/><Setter TargetName="Grip" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="Grip" Property="VerticalAlignment" Value="Center"/><Setter TargetName="Grip" Property="Margin" Value="2,0"/>
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.7"/></Trigger>
        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Vertical"><Setter Property="MinWidth" Value="12"/><Setter Property="MaxWidth" Value="12"/></Trigger>
    <Trigger Property="Orientation" Value="Horizontal"><Setter Property="MinHeight" Value="12"/><Setter Property="MaxHeight" Value="12"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource Surface}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}"/><Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Line}"/><Setter Property="GridLinesVisibility" Value="All"/><Setter Property="RowHeight" Value="37"/><Setter Property="ColumnHeaderHeight" Value="35"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Property}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="15,5"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Add"><Setter Property="Height" Value="26"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Comment"><Setter Property="Height" Value="26"/><Setter Property="FontSize" Value="12"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="body" Padding="12,8" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Blue}"/><Setter TargetName="body" Property="BorderBrush" Value="{DynamicResource Blue}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Application.Resources>
</Application>
