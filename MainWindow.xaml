 <TextBox x:Name="Source" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="14" TextChanged="SourceChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="20"/>
 </Grid>
