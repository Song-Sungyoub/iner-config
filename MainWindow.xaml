 <Button x:Name="FinishStructureButton" Content="완료" Click="FinishStructure" Visibility="Collapsed"/>
 <Button x:Name="CancelStructureButton" Content="전체 취소" Click="CancelStructure" Visibility="Collapsed"/>
 <Button Content="도구 ▾" Click="ToolbarTools"/>
 </StackPanel>
 <StackPanel Orientation="Horizontal">
 <Button Content="파일 ▾" Click="FileMenu" ToolTip="새 파일 · 열기 · 최근 파일 · 저장"/>
 <Border Width="1" Margin="8,6" Background="{DynamicResource Line}"/>
 <Border CornerRadius="7" Background="{DynamicResource Property}"><StackPanel Orientation="Horizontal">
