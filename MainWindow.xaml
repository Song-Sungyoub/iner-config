 </StackPanel>
 <Border Grid.Row="4" x:Name="SearchPanel" Panel.ZIndex="10" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,8,20,0" Padding="10,8" CornerRadius="9" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
  <StackPanel Orientation="Horizontal"><TextBox x:Name="Search" Width="250" MinHeight="30" ToolTip="속성 또는 값 검색 · Ctrl+F · Esc로 닫기" TextChanged="SearchChanged"/><Button Content="×" ToolTip="검색 닫기 · Esc" Width="30" Padding="4,0" Margin="8,0,0,0" Background="Transparent" Click="CloseSearch"/></StackPanel>
 </Border>
 <Border Grid.Row="5" Background="{DynamicResource Property}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,5"><StackPanel><TextBlock x:Name="NodePath" Text="값을 더블클릭하거나 ⋯ 메뉴를 여세요." FontSize="12"/><TextBlock x:Name="Message" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
