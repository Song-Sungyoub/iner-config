 <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="▾" ToolTip="열린 탭 목록" Click="OpenTabs" Margin="0,0,16,0"/><TabControl x:Name="Files" ToolTip="탭 드래그: 순서 변경·다른 창으로 이동 · 밖으로 끌기: 새 창 · 오른쪽 클릭: 이동 메뉴" SelectionChanged="TabChanged" PreviewMouseLeftButtonDown="TabMouseDown" PreviewMouseLeftButtonUp="TabMouseUp" PreviewMouseMove="TabMouseMove" PreviewMouseRightButtonDown="TabContextMenu" QueryContinueDrag="TabDragContinue" AllowDrop="True" DragOver="TabDragOver" Drop="TabDrop" Background="Transparent" BorderThickness="0" Padding="0" Margin="16,0"><TabControl.Template><ControlTemplate TargetType="TabControl"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel IsItemsHost="True" Orientation="Horizontal"/></ScrollViewer></ControlTemplate></TabControl.Template><TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" ToolTip="{Binding FilePath}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Content="×" Padding="5,0" Margin="8,0,0,0" Background="Transparent" Click="CloseTab"/></StackPanel></DataTemplate></TabControl.ItemTemplate></TabControl></DockPanel>
 <DockPanel Grid.Row="3" Margin="16,8">
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
