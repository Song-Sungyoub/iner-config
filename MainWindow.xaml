 <DataGridTemplateColumn Header="속성" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
  <Border x:Name="PropertyCell" Padding="12,0" ClipToBounds="True" Background="Transparent"><Grid>
   <local:TreeGuides Node="{Binding}" Stroke="{DynamicResource Muted}" Opacity="0.5" IsHitTestVisible="False"/>
   <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
    <Button Content="{Binding}" ContentTemplate="{StaticResource NodeArrow}" ToolTip="클릭: 펼치기/접기 · Alt+클릭: 모든 하위 항목 포함" Width="22" Padding="0" Margin="0" Background="Transparent" Click="ToggleNode"/>
    <local:AddItemButton x:Name="AddControl" Visibility="Collapsed"/><TextBlock Visibility="{Binding Visibility, ElementName=FinishStructureButton}" Text="⠿" Width="16" ToolTip="구조 편집에서 드래그로 순서 변경" Cursor="SizeAll"/><TextBlock x:Name="PropertyName" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
    <Border x:Name="CountBadge" Visibility="Collapsed" CornerRadius="5" Background="{DynamicResource Property}" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center" ToolTip="하위 항목 수"><TextBlock Text="{Binding ChildCount}" FontSize="10" Foreground="{DynamicResource Muted}"/></Border>
   </StackPanel>
  </Grid></Border>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding PendingDelete}" Value="True"><Setter TargetName="PropertyName" Property="TextDecorations" Value="Strikethrough"/><Setter TargetName="PropertyName" Property="Opacity" Value="0.5"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Add"><Setter TargetName="AddControl" Property="Visibility" Value="Visible"/><Setter TargetName="PropertyName" Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Group}" Value="True"><Setter TargetName="PropertyName" Property="FontWeight" Value="SemiBold"/><Setter TargetName="CountBadge" Property="Visibility" Value="Visible"/></DataTrigger>

   <DataTrigger Binding="{Binding DepthBand}" Value="0"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource DepthText0}"/></DataTrigger>
   <DataTrigger Binding="{Binding DepthBand}" Value="1"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource DepthText1}"/></DataTrigger>
   <DataTrigger Binding="{Binding DepthBand}" Value="2"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource DepthText2}"/></DataTrigger>
   <DataTrigger Binding="{Binding DepthBand}" Value="3"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource DepthText3}"/></DataTrigger>
   <DataTrigger Binding="{Binding DepthBand}" Value="4"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource DepthText4}"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Comment"><Setter TargetName="PropertyName" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="PropertyName" Property="FontSize" Value="12"/></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="값" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="15,0"><TextBlock x:Name="ValueText" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><CheckBox x:Name="BoolValue" Visibility="Collapsed" IsEnabled="{Binding Editable}" Content="{Binding Value}" Click="ToggleBool"/></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="Comment"><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="ValueText" Property="FontSize" Value="12"/></DataTrigger><DataTrigger Binding="{Binding Group}" Value="True"><Setter TargetName="ValueText" Property="FontSize" Value="11"/><Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="ValueText" Property="Opacity" Value="0.7"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Boolean"><Setter TargetName="ValueText" Property="Visibility" Value="Collapsed"/><Setter TargetName="BoolValue" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Value}" Value="true"><Setter TargetName="BoolValue" Property="IsChecked" Value="True"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="자료형" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:TypePicker Margin="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="상태" Binding="{Binding State}" ElementStyle="{StaticResource GridText}" Width="90"/>
 <DataGridTemplateColumn Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="⋯" Background="Transparent" Padding="3" Click="NodeMenu"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid>
 <DataGrid x:Name="Stage" CanUserResizeColumns="False" Visibility="Collapsed" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="StageSelectionChanged" GridLinesVisibility="Horizontal" RowHeight="NaN" EnableColumnVirtualization="False"><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="Height" Value="40"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Add"><Setter Property="Height" Value="26"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
  <DataGrid.Resources><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource Property}"/></Style></DataGrid.Resources>
  <DataGrid.Columns><DataGridTemplateColumn><DataGridTemplateColumn.CellTemplate><DataTemplate><local:StageRow/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
 </DataGrid>
 <ScrollViewer x:Name="Groups" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GroupContent" MinWidth="560" Margin="16,0,16,16"/></ScrollViewer>
