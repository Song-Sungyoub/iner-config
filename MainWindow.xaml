 <TextBlock Text="설정 파일을 열어 시작하세요" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
 <TextBlock Text="JSON · XML · YAML · INI · CSV" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,20"/>
