  <StackPanel x:Name="WindowButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화" Click="Minimize"/>
   <Button x:Name="MaximizeButton" Click="Maximize"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="Content" Value="&#xE922;"/><Setter Property="ToolTip" Value="최대화"/><Setter Property="AutomationProperties.Name" Value="최대화"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="&#xE923;"/><Setter Property="ToolTip" Value="복원"/><Setter Property="AutomationProperties.Name" Value="복원"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   <Button x:Name="CloseWindowButton" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기" Click="CloseApp"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style></Button>
